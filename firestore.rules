rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // STRICT LOCKDOWN: All data (tests with answer keys, users, attempts, enquiries, security settings)
    // is accessed exclusively via the authenticated Express backend + Firebase Admin SDK.
    // Prevents any client-side Firestore REST query from reading answer keys or user records.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
